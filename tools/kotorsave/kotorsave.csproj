<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>kotorsave</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Vendored KotOR_IO is .NET Framework 4.5.2-era code; it trips a pile of
         unused-local / unassigned-field warnings that we neither own nor want
         to patch. Same suppression list build/saveedit uses. -->
    <NoWarn>CS0168;CS0219;CS0414;CS0649;CS0162;CS0659</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- KotOR_IO's own csproj targets net452 and references System.Windows.Forms,
         so it cannot be ProjectReference'd from net10.0. Pull in the handful of
         source files the ERF -> ERF -> GFF walk actually needs. KIO.cs carries
         Reference_Tables + GffFieldType; compile it from upstream rather than
         keeping a trimmed copy here, so the resource-type table can never drift. -->
    <Compile Include="..\..\third_party\KotOR_IO\KotOR_IO\KIO.cs" />
    <Compile Include="..\..\third_party\KotOR_IO\KotOR_IO\File Formats\KFile.cs" />
    <Compile Include="..\..\third_party\KotOR_IO\KotOR_IO\File Formats\ERF.cs" />
    <Compile Include="..\..\third_party\KotOR_IO\KotOR_IO\File Formats\GFF.cs" />
    <Compile Include="..\..\third_party\KotOR_IO\KotOR_IO\File Formats\GFF FieldTypes\*.cs" />
  </ItemGroup>

</Project>
